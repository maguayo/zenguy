{
  "name": "@zenguy/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/local-secrets.mjs run dev",
    "deploy": "node scripts/deploy.mjs",
    "deploy:preflight:staging": "node scripts/verify-remote-secrets.mjs staging",
    "deploy:preflight:production": "node scripts/verify-remote-secrets.mjs production",
    "deploy:kms:bootstrap:staging": "wrangler deploy --config wrangler.kms.jsonc --env staging",
    "deploy:kms:bootstrap:production": "wrangler deploy --config wrangler.kms.jsonc --env production",
    "deploy:kms:staging": "node scripts/deploy-kms.mjs staging",
    "deploy:kms:production": "node scripts/deploy-kms.mjs production",
    "deploy:staging": "node scripts/deploy.mjs staging",
    "deploy:production:bootstrap": "wrangler deploy --config wrangler.production-bootstrap.jsonc",
    "deploy:production": "node scripts/deploy.mjs production",
    "typecheck": "wrangler types --check && tsc --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:local-secrets": "node --test scripts/local-secrets.test.mjs",
    "benchmark:password-kdf": "node scripts/benchmark-password-kdf.mjs",
    "db:migrate:local": "wrangler d1 migrations apply zenguy-local-db --local",
    "db:migrate:staging": "wrangler d1 migrations apply zenguy-staging-db --remote --env staging",
    "db:migrate:production": "wrangler d1 migrations apply zenguy-db --remote --env production",
    "secrets:list": "node scripts/local-secrets.mjs list",
    "secrets:status": "node scripts/local-secrets.mjs status",
    "secrets:audit-local": "node scripts/local-secrets.mjs audit-local",
    "secrets:verify": "node scripts/local-secrets.mjs verify",
    "secrets:set": "node scripts/local-secrets.mjs set",
    "seed": "node scripts/local-secrets.mjs run seed"
  },
  "dependencies": {
    "@cloudflare/containers": "^0.3.7",
    "@cloudflare/puppeteer": "^1.3.0",
    "@hono/zod-validator": "^0.9.0",
    "hono": "^4.13.2",
    "jose": "^6.2.10",
    "ulid": "^3.0.2",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@types/node": "^26.2.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.125.0"
  }
}
