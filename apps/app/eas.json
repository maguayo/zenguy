{
  "cli": {
    "version": "23.2.0",
    "appVersionSource": "remote",
    "requireCommit": true
  },
  "build": {
    "development": {
      "environment": "development",
      "node": "22.23.2",
      "channel": "development",
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "image": "macos-tahoe-26.5-xcode-26.6",
        "simulator": true
      },
      "env": {
        "APP_VARIANT": "development",
        "EXPO_PUBLIC_API_ORIGIN": "https://api-staging.zenguy.com"
      }
    },
    "preview": {
      "environment": "preview",
      "node": "22.23.2",
      "channel": "preview",
      "distribution": "internal",
      "ios": {
        "image": "macos-tahoe-26.5-xcode-26.6"
      },
      "env": {
        "APP_VARIANT": "preview",
        "EXPO_PUBLIC_API_ORIGIN": "https://api-staging.zenguy.com"
      }
    },
    "production": {
      "environment": "production",
      "node": "22.23.2",
      "channel": "production",
      "autoIncrement": true,
      "ios": {
        "image": "macos-tahoe-26.5-xcode-26.6"
      },
      "env": {
        "APP_VARIANT": "production",
        "EXPO_PUBLIC_API_ORIGIN": "https://api.zenguy.com"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6804201911"
      }
    },
    "app-review-metadata": {
      "ios": {
        "ascAppId": "6804201911",
        "metadataPath": "./store.review.config.cjs"
      }
    }
  }
}
