---
import Base from "../layouts/Base.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
---

<Base title="Page not found — Zenguy" description="This page doesn't exist.">
  <div class="flex min-h-screen flex-col bg-cream">
    <Nav />
    <main class="container-site flex flex-1 flex-col items-center justify-center px-10 py-24 text-center">
      <span class="font-mono text-xs text-muted">404</span>
      <h1 class="m-0 mt-4 text-[40px] font-semibold leading-[1.14] tracking-[-0.025em]">
        This page isn't monitored.
      </h1>
      <p class="m-0 mt-3 max-w-md text-[16px] leading-[1.62] text-body">
        It doesn't exist — nothing to check here.
      </p>
      <a href="/" class="btn btn-violet mt-8 rounded-[10px] px-[22px] py-[13px] text-[15px] font-medium">
        Back to Zenguy
      </a>
    </main>
    <Footer />
  </div>
</Base>
