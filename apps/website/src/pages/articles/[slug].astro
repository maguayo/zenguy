---
import { getCollection, getEntry, render } from "astro:content";
import type { GetStaticPaths } from "astro";
import Base from "../../layouts/Base.astro";
import Nav from "../../components/Nav.astro";
import Footer from "../../components/Footer.astro";
import ArticleCta from "../../components/ArticleCta.astro";
import {
  SITE_URL,
  articleCategories,
  articleHref,
  formatArticleDate,
  innerNavLinks,
  readingMinutes,
} from "../../lib/site";

export const getStaticPaths = (async () => {
  const articles = await getCollection("articles");
  return articles.map((article) => ({
    params: { slug: article.id },
    props: { article },
  }));
}) satisfies GetStaticPaths;

const { article } = Astro.props;
const { Content } = await render(article);
const related = (
  await Promise.all(article.data.related.map((id) => getEntry("articles", id)))
).filter((entry): entry is NonNullable<typeof entry> => entry != null);

const title = `${article.data.title} — Zenguy`;
const canonical = `${SITE_URL}${articleHref(article.id)}`;
const published = article.data.pubDate;
const modified = article.data.updatedDate ?? published;
const minutes = readingMinutes(article.body ?? "");
const showDisclosure =
  article.data.category === "comparison" || article.data.category === "roundup";

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "Article",
    headline: article.data.title,
    description: article.data.description,
    datePublished: published.toISOString(),
    dateModified: modified.toISOString(),
    inLanguage: "en",
    author: { "@type": "Organization", name: "Zenguy", url: SITE_URL },
    publisher: { "@type": "Organization", name: "Zenguy", url: SITE_URL },
    mainEntityOfPage: { "@type": "WebPage", "@id": canonical },
    url: canonical,
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: SITE_URL },
      { "@type": "ListItem", position: 2, name: "Articles", item: `${SITE_URL}/articles/` },
      { "@type": "ListItem", position: 3, name: article.data.title, item: canonical },
    ],
  },
];
---

<Base title={title} description={article.data.description} ogType="article" publishedTime={published}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </Fragment>
  <div class="flex min-h-screen min-w-0 flex-col overflow-x-clip bg-cream">
    <Nav links={innerNavLinks} />
    <main class="min-w-0 flex-1 px-10 py-[72px] max-md:px-5 max-md:py-12">
      <article class="container-site max-w-[720px] min-w-0">
        <nav class="mb-8 font-mono text-[12px] text-muted" aria-label="Breadcrumb">
          <a href="/articles/" class="link-quiet">Articles</a>
          <span class="px-1.5" aria-hidden="true">/</span>
          <span>{articleCategories[article.data.category]}</span>
        </nav>

        <header class="mb-10">
          <div class="flex flex-wrap items-center gap-x-3 gap-y-1 font-mono text-[12px] text-muted">
            <span>{articleCategories[article.data.category]}</span>
            <span aria-hidden="true">·</span>
            <time datetime={published.toISOString()}>{formatArticleDate(published)}</time>
            <span aria-hidden="true">·</span>
            <span>{minutes} min read</span>
          </div>
          <h1 class="m-0 mt-3 wrap-break-word text-[40px] font-semibold leading-[1.12] tracking-[-0.03em] max-md:text-[30px]">
            {article.data.title}
          </h1>
          <p class="m-0 mt-4 text-[18px] leading-[1.55] text-body">
            {article.data.description}
          </p>
        </header>

        {showDisclosure && (
          <aside class="mb-10 rounded-[12px] border border-line bg-surface px-5 py-4 text-[13.5px] leading-[1.55] text-body">
            <strong class="text-ink">Written by Zenguy.</strong>
            {" "}We sell browser tests in plain English and HTTP uptime monitoring.
            Competitor names identify those products; they are not affiliates.
            Feature and price notes use public pages as of August 2026 and can change
            — confirm on each vendor's site before you buy.
          </aside>
        )}

        <div class="article-body">
          <Content />
        </div>

        <div class="mt-14">
          <ArticleCta />
        </div>

        {related.length > 0 && (
          <section class="mt-14 border-t border-line pt-8">
            <h2 class="m-0 font-mono text-[11px] font-medium uppercase tracking-[0.08em] text-muted">
              Related
            </h2>
            <ul class="mt-3 m-0 list-none p-0">
              {related.map((entry) => (
                <li class="border-t border-line">
                  <a href={articleHref(entry.id)} class="block py-3.5">
                    <span class="block text-[15.5px] font-semibold leading-[1.3] text-ink">
                      {entry.data.title}
                    </span>
                    <span class="mt-1 block text-[13.5px] leading-[1.5] text-body">
                      {entry.data.description}
                    </span>
                  </a>
                </li>
              ))}
            </ul>
          </section>
        )}
      </article>
    </main>
    <Footer />
  </div>
</Base>
