---
import { homeNavLinks } from "../lib/site";
import Logo from "./Logo.astro";

interface Props {
  homeHref?: string;
  links?: { href: string; label: string }[];
}

const { homeHref = "/", links = homeNavLinks } = Astro.props;
---

<header class="sticky top-0 z-20 border-b border-line bg-surface px-10 max-md:px-5">
  <div class="container-site flex min-w-0 h-[66px] items-center gap-9 max-md:gap-5">
    <a href={homeHref} class="btn flex items-center" aria-label="Zenguy home">
      <Logo iconSize={24} />
    </a>
    <nav class="flex items-center gap-[26px] max-md:hidden" aria-label="Main">
      {links.map((l) => (
        <a href={l.href} class="link-quiet text-sm">{l.label}</a>
      ))}
    </nav>
    <div class="flex-1"></div>
    <a
      href="https://app.zenguy.com/signin"
      class="link-quiet text-sm max-md:hidden"
      data-analytics-cta="nav_signin"
      data-analytics-destination="signin">Sign in</a
    >
    <a
      href="https://app.zenguy.com/signup"
      class="btn btn-violet rounded-lg px-4 py-[9px] text-sm font-medium"
      data-analytics-cta="nav_signup"
      data-analytics-destination="signup">Get started</a
    >
  </div>
</header>
