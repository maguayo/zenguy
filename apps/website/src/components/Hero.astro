---
import Icon from "./Icon.astro";

interface Props {
  failureHref?: string;
}

const { failureHref = "#evidence" } = Astro.props;
---

<section class="px-10 pt-[92px] pb-[100px] max-md:px-5 max-md:pt-16 max-md:pb-16">
  <div
    class="container-site grid grid-cols-[minmax(0,1.15fr)_minmax(0,1fr)] items-center gap-[72px] max-lg:grid-cols-1 max-lg:gap-16"
  >
    <div class="flex flex-col items-start gap-[26px]">
      <h1
        class="m-0 text-[64px] font-bold leading-[0.99] tracking-[-0.042em] [text-wrap:balance] max-md:text-[42px]"
      >
        Browser tests in plain English, run every hour in a real browser.
      </h1>

      <p class="m-0 max-w-[540px] text-[20px] leading-[1.5] text-body [text-wrap:pretty] max-md:text-[18px]">
        Describe a flow once. Zenguy walks it on a schedule and, when it stops working, sends you
        the screenshots, the steps and the reason before a customer finds it.
      </p>

      <div class="flex flex-wrap items-center gap-3.5">
        <a href="https://app.zenguy.com" class="btn btn-violet rounded-[10px] px-[26px] py-[15px] text-[16px] font-medium">
          Get started
        </a>
        <a href={failureHref} class="btn btn-outline rounded-[10px] px-[26px] py-[15px] text-[16px] font-medium">
          See a real failure
        </a>
      </div>

      <div class="flex flex-wrap items-center gap-x-[22px] gap-y-1.5 font-mono text-sm text-stone">
        <span>39 € a month</span>
        <span>300 runs</span>
        <span>uptime free</span>
      </div>
    </div>

    <div class="relative">
      <!-- Test card -->
      <div class="card-shadow overflow-hidden rounded-[14px] border border-line bg-surface">
        <div class="flex items-center gap-2.5 border-b border-line px-[18px] py-3.5">
          <Icon name="monitor" size={16} />
          <span class="text-[13.5px] font-semibold">Checkout — production</span>
          <span class="rounded-full bg-cream px-[9px] py-[3px] font-mono text-[11.5px] text-body">Every 1 hour</span>
          <div class="flex-1"></div>
          <span class="text-[11.5px] text-muted">Desktop · 1440 × 900</span>
        </div>
        <div class="p-[18px]">
          <div class="rounded-[10px] border border-line bg-surface px-[17px] py-4 text-[14.5px] leading-[1.68]">
            Go to example.com. Check that the home page shows more than four products. Open one and
            make sure the product detail page works. Remember the crossed-out and current prices,
            add the product to the cart, and check that the prices and totals are correct. Continue
            to checkout and check them again. Don't place the order.
          </div>
          <div class="flex items-center gap-2.5 pt-3.5">
            <span class="text-xs text-muted">No selectors. No code. No framework to learn.</span>
            <div class="flex-1"></div>
            <span class="whitespace-nowrap rounded-lg bg-ink px-[13px] py-[7px] text-[12.5px] font-medium text-surface">Test it</span>
          </div>
        </div>
      </div>

      <span
        class="font-hand absolute -top-[30px] right-1.5 -rotate-4 text-[27px] leading-none font-bold text-violet"
        aria-hidden="true">that's the whole test</span
      >
    </div>
  </div>
</section>
