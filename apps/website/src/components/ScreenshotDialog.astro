<dialog
  id="screenshot-dialog"
  class="screenshot-dialog m-auto max-h-[calc(100dvh_-_32px)] w-[min(900px,calc(100%_-_32px))] max-w-none overflow-hidden rounded-[18px] border border-line bg-surface p-0 text-ink"
  aria-labelledby="screenshot-dialog-title"
  aria-describedby="screenshot-dialog-caption"
>
  <div class="flex items-center gap-5 border-b border-line px-5 py-4">
    <h3 id="screenshot-dialog-title" class="screenshot-dialog-title m-0 min-w-0 flex-1 text-[16px] font-semibold">
      Run screenshot
    </h3>
    <button
      type="button"
      class="screenshot-dialog-close inline-flex h-8 w-8 shrink-0 cursor-pointer items-center justify-center rounded-lg border border-line bg-surface text-[20px] leading-none text-body transition-colors hover:bg-cream focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-violet"
      aria-label="Close screenshot"
      autofocus
    >
      &times;
    </button>
  </div>
  <figure class="m-0 min-h-0 overflow-auto bg-cream p-5 max-md:p-3">
    <img
      src="/hero/step-home.png"
      alt=""
      width="600"
      height="375"
      class="screenshot-dialog-image mx-auto h-auto max-h-[calc(100dvh_-_180px)] w-full rounded-xl border border-line bg-surface object-contain"
    />
    <figcaption
      id="screenshot-dialog-caption"
      class="screenshot-dialog-caption mx-auto mt-3 max-w-[760px] text-[13px] leading-[1.5] text-muted"
    ></figcaption>
  </figure>
</dialog>

<style>
  .screenshot-dialog {
    box-shadow:
      rgba(19, 17, 13, 0.12) 0 4px 12px,
      rgba(19, 17, 13, 0.3) 0 28px 80px;
  }

  .screenshot-dialog::backdrop {
    background: rgba(19, 17, 13, 0.58);
    backdrop-filter: blur(5px);
  }

  .screenshot-dialog[open] {
    animation: screenshot-dialog-in 180ms cubic-bezier(0.32, 0.72, 0, 1);
  }

  @keyframes screenshot-dialog-in {
    from {
      opacity: 0;
      transform: translateY(10px) scale(0.98);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .screenshot-dialog[open] {
      animation: none;
    }
  }
</style>

<script>
  const screenshotDialog = document.querySelector<HTMLDialogElement>("#screenshot-dialog");

  if (screenshotDialog) {
    const screenshotImage = screenshotDialog.querySelector<HTMLImageElement>(".screenshot-dialog-image");
    const screenshotTitle = screenshotDialog.querySelector<HTMLElement>(".screenshot-dialog-title");
    const screenshotCaption = screenshotDialog.querySelector<HTMLElement>(".screenshot-dialog-caption");
    const screenshotClose = screenshotDialog.querySelector<HTMLButtonElement>(".screenshot-dialog-close");
    let activeTrigger: HTMLAnchorElement | null = null;
    let previousHtmlOverflow = "";
    let previousBodyOverflow = "";

    document.querySelectorAll<HTMLAnchorElement>("[data-screenshot-trigger]").forEach((trigger) => {
      trigger.addEventListener("click", (event) => {
        if (
          event.defaultPrevented ||
          event.button !== 0 ||
          event.metaKey ||
          event.ctrlKey ||
          event.shiftKey ||
          event.altKey ||
          typeof screenshotDialog.showModal !== "function"
        ) {
          return;
        }

        const src = trigger.dataset.screenshotSrc;
        if (!src || !screenshotImage || !screenshotTitle || !screenshotCaption) return;

        event.preventDefault();
        activeTrigger = trigger;
        screenshotImage.src = src;
        screenshotImage.alt = trigger.dataset.screenshotAlt ?? "Run screenshot";
        screenshotTitle.textContent = trigger.dataset.screenshotTitle ?? "Run screenshot";
        screenshotCaption.textContent = trigger.dataset.screenshotCaption ?? "";

        previousHtmlOverflow = document.documentElement.style.overflow;
        previousBodyOverflow = document.body.style.overflow;
        document.documentElement.style.overflow = "hidden";
        document.body.style.overflow = "hidden";
        screenshotDialog.showModal();
      });
    });

    screenshotClose?.addEventListener("click", () => screenshotDialog.close());

    screenshotDialog.addEventListener("click", (event) => {
      if (event.target !== screenshotDialog) return;
      const bounds = screenshotDialog.getBoundingClientRect();
      const clickedInside =
        event.clientX >= bounds.left &&
        event.clientX <= bounds.right &&
        event.clientY >= bounds.top &&
        event.clientY <= bounds.bottom;
      if (!clickedInside) screenshotDialog.close();
    });

    screenshotDialog.addEventListener("keydown", (event) => {
      if (event.key === "Escape") {
        event.preventDefault();
        screenshotDialog.close();
      }
    });

    screenshotDialog.addEventListener("close", () => {
      document.documentElement.style.overflow = previousHtmlOverflow;
      document.body.style.overflow = previousBodyOverflow;
      activeTrigger?.focus();
      activeTrigger = null;
    });
  }
</script>
