---
// Proposal 2 — the Production band retold as a scene. "Thirteen hours." is
// the section's headline and is ALWAYS visible — the message never hides
// behind JS; only the timeline above it draws itself in (~2 s) when the
// section enters the viewport. The CI comparison is the quiet closing line
// instead of the headline. With reduced motion or without JS the finished
// scene is simply there.
const moments = [
  {
    time: "14:02",
    label: "CI",
    title: "Merge approved",
    tone: "text-green",
    dot: "bg-green",
    panel: "border-green/25 bg-green/[0.045]",
    step: "n-s1",
    delta: "",
    body: "214 tests pass. The build ships and everyone goes home.",
  },
  {
    time: "03:14",
    label: "Live site",
    title: "Checkout breaks",
    tone: "text-red",
    dot: "bg-red zg-pulse",
    panel: "border-red/35 bg-red/[0.06]",
    step: "n-s2",
    delta: "+13 h 12 m",
    body: "A third-party price feed goes quiet. Checkout totals become 0,00 € — with a 200 on every request.",
  },
  {
    time: "09:40",
    label: "Support",
    title: "A customer finds it",
    tone: "text-surface/50",
    dot: "bg-surface/50",
    panel: "border-white/12 bg-white/[0.035]",
    step: "n-s3",
    delta: "+6 h 26 m",
    body: "A customer asks whether the sale is meant to be free. Support starts tracing a change nobody made.",
  },
];
---

<section id="production" class="night bg-ink px-10 pt-[84px] pb-[92px] max-md:px-5 max-md:py-16">
  <div class="container-site flex flex-col gap-10">
    <span class="font-mono text-[11px] font-medium uppercase tracking-[0.08em] text-dusk">Production</span>

    <div class="relative">
      <div class="absolute left-[16.666%] right-[16.666%] top-5 h-px bg-white/14 max-lg:hidden" aria-hidden="true">
        <span class="absolute left-1/4 top-1/2 -translate-x-1/2 -translate-y-1/2 bg-ink px-2 font-mono text-[10px] text-dusk">
          13 h 12 m
        </span>
        <span class="absolute left-3/4 top-1/2 -translate-x-1/2 -translate-y-1/2 bg-ink px-2 font-mono text-[10px] text-dusk">
          6 h 26 m
        </span>
      </div>
      <div class="absolute bottom-6 left-[19px] top-5 hidden w-px bg-white/14 max-lg:block" aria-hidden="true"></div>

      <ol class="relative m-0 grid list-none grid-cols-3 gap-5 p-0 max-lg:grid-cols-1 max-lg:gap-5">
        {moments.map((m) => (
          <li class:list={["flex flex-col gap-3 max-lg:grid max-lg:grid-cols-[40px_minmax(0,1fr)] max-lg:gap-4", m.step]}>
            <span class="relative z-[1] mx-auto flex h-10 w-10 items-center justify-center rounded-full border border-white/14 bg-ink max-lg:mx-0" aria-hidden="true">
              <span class:list={["h-2.5 w-2.5 rounded-full", m.dot]}></span>
            </span>
            <div class:list={["flex min-h-[178px] flex-col rounded-[14px] border p-5", m.panel]}>
              <div class="flex items-center gap-3">
                <span class="font-mono text-[10.5px] font-medium uppercase tracking-[0.08em] text-dusk">{m.label}</span>
                {m.delta && <span class="hidden font-mono text-[10.5px] text-dusk max-lg:inline">{m.delta}</span>}
                <span class:list={["ml-auto font-mono text-[12.5px]", m.tone]}>{m.time}</span>
              </div>
              <h3 class="m-0 mt-5 text-[18px] font-semibold leading-[1.3] text-surface">{m.title}</h3>
              <p class="m-0 mt-2 text-[14.5px] leading-[1.55] text-parch [text-wrap:pretty]">{m.body}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>

    <div class="flex flex-col gap-4 border-t border-white/8 pt-10">
      <h2 class="m-0 text-[clamp(54px,8.5vw,104px)] font-bold leading-[0.98] tracking-[-0.045em] text-surface">
        Thirteen hours.
      </h2>
      <p class="n-alt m-0 max-w-[720px] text-[clamp(21px,2.6vw,30px)] font-semibold leading-[1.25] tracking-[-0.02em] text-violet-soft [text-wrap:pretty]">
        Or seven minutes, if something walks the checkout all night.
      </p>
      <p class="n-closer m-0 text-[15px] leading-[1.6] text-parch">
        Your tests prove the merge was fine. This proves production still is.
      </p>
    </div>
  </div>
</section>

<style>
  /* Hidden states live under .night-armed so no-JS and reduced-motion readers
     get the finished scene immediately. */
  .night-armed .n-s1,
  .night-armed .n-s2,
  .night-armed .n-s3,
  .night-armed .n-alt,
  .night-armed .n-closer {
    opacity: 0;
    visibility: hidden;
    transform: translateY(10px);
    transition:
      opacity 0.55s cubic-bezier(0.32, 0.72, 0, 1),
      transform 0.55s cubic-bezier(0.32, 0.72, 0, 1),
      visibility 0s linear;
  }

  .night-play .n-s1 { opacity: 1; visibility: visible; transform: none; transition-delay: 0.05s; }
  .night-play .n-s2 { opacity: 1; visibility: visible; transform: none; transition-delay: 0.4s; }
  .night-play .n-s3 { opacity: 1; visibility: visible; transform: none; transition-delay: 0.75s; }
  .night-play .n-alt { opacity: 1; visibility: visible; transform: none; transition-delay: 1.05s; }
  .night-play .n-closer { opacity: 1; visibility: visible; transform: none; transition-delay: 1.3s; }
</style>

<script>
  const night = document.querySelector<HTMLElement>(".night");
  const motionOk =
    typeof matchMedia === "function" && !matchMedia("(prefers-reduced-motion: reduce)").matches;
  if (night && motionOk && "IntersectionObserver" in window) {
    night.classList.add("night-armed");
    new IntersectionObserver(
      (entries, observer) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            night.classList.add("night-play");
            observer.disconnect();
          }
        }
      },
      { threshold: 0.2 },
    ).observe(night);
  }
</script>
