---
// Proposal 2 — the trust section. Resurrects the dropped Secrets.astro cards
// and adds the two guarantees that were scattered as one-liners elsewhere:
// irreversible actions and redaction/retention. Answers the one question the
// live page never faces head-on: "can I let an agent loose on my site?"
import Icon from "./../Icon.astro";

const cards = [
  {
    icon: "key" as const,
    title: "Write only",
    body: "Save a value once and nobody sees it again, at any role. Not in the app, not in a report, not in a screenshot, not in a log. You replace it, you never read it.",
  },
  {
    icon: "shield" as const,
    title: "Pinned to your domains",
    body: "A secret is only ever typed while the live domain matches the list you gave it, checked again after every redirect.",
  },
  {
    icon: "terminal" as const,
    title: "Page content is untrusted",
    body: "Text found on a website is data, never instruction. Nothing on a page can talk the agent into handing over a credential.",
  },
  {
    icon: "circleslash" as const,
    title: "Never places the order",
    body: "Irreversible actions are avoided by default. Your instructions say exactly how far a test may go, and it stops there.",
  },
  {
    icon: "camera" as const,
    title: "Redacted everywhere",
    body: "Secret values are blanked in every screenshot, report and log. Evidence is kept for 30 days, then deleted.",
  },
];
---

<section id="trust" class="px-10 py-[88px] max-md:px-5 max-md:py-16">
  <div class="container-site">
    <div class="mb-12 flex max-w-[640px] flex-col gap-3.5">
      <span class="eyebrow">Trust</span>
      <h2 class="m-0 text-[40px] font-semibold leading-[1.14] tracking-[-0.025em] max-md:text-[32px]">
        Your staging password stays a secret.
      </h2>
      <p class="m-0 text-[16px] leading-[1.62] text-body [text-wrap:pretty]">
        Letting an agent walk your site is a trust decision. This is exactly what it will and
        won't do.
      </p>
    </div>
    <div class="grid grid-cols-6 gap-5 max-lg:grid-cols-1">
      {cards.map((c, i) => (
        <div
          class:list={[
            "flex flex-col gap-3 rounded-[13px] border border-line bg-surface p-6 shadow-[0_1px_2px_rgba(19,17,13,0.04)]",
            i < 3 ? "col-span-2" : "col-span-3",
            "max-lg:col-span-1",
          ]}
        >
          <Icon name={c.icon} size={19} />
          <h3 class="m-0 text-[17px] font-semibold leading-[1.3]">{c.title}</h3>
          <p class="m-0 text-[13.5px] leading-[1.6] text-body [text-wrap:pretty]">{c.body}</p>
        </div>
      ))}
    </div>
  </div>
</section>
