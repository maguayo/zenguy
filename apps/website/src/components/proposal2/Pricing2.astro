---
// Proposal 2 — one plan, with the three practical benefits surfaced beside
// the detailed allowance. No trial is promised — checkout charges from day
// one.
import Icon from "./../Icon.astro";
import Logo from "./../Logo.astro";

const benefits = [
  {
    title: "Up to 3 automatic retries",
    body: "Confirm a failure before Zenguy opens an incident or alerts the team.",
  },
  {
    title: "Unlimited uptime monitors",
    body: "Check every endpoint without spending a browser-test run.",
  },
  {
    title: "Unlimited teammates",
    body: "Bring engineering, support and operations into one workspace.",
  },
];
const included = [
  "300 browser test runs a month",
  "0,20 € per run after that",
  "Unlimited uptime monitors",
  "Unlimited members and invitations",
  "Desktop and mobile viewports",
  "30 days of screenshots, reports and logs",
  "Every alert channel, no message fees",
];
---

<section id="pricing" class="border-y border-line bg-surface px-10 py-24 max-md:px-5 max-md:py-16">
  <div
    class="container-site grid grid-cols-[minmax(0,1fr)_420px] items-center gap-16 max-lg:grid-cols-1 max-lg:gap-12"
  >
    <div class="flex flex-col gap-5">
      <span class="eyebrow">Pricing</span>
      <h2 class="m-0 text-[44px] font-semibold leading-[1.12] tracking-[-0.025em] [text-wrap:balance] max-md:text-[34px]">
        One plan. Priced by runs, not by people.
      </h2>
      <p class="m-0 max-w-[480px] text-[16px] leading-[1.62] text-body [text-wrap:pretty]">
        A run is one requested execution: a scheduled run, a manual run, or a validation from the
        editor. Invite the whole team at no extra cost.
      </p>
      <div class="grid gap-3 pt-1.5">
        {benefits.map((benefit, index) => (
          <div class="flex items-start gap-3.5 rounded-xl border border-line bg-cream/55 px-4 py-3.5">
            <span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-lg bg-violet-bg font-mono text-[11px] font-medium text-violet-deep">
              {String(index + 1).padStart(2, "0")}
            </span>
            <div class="flex flex-col gap-0.5">
              <span class="text-[14px] font-semibold text-ink">{benefit.title}</span>
              <span class="text-[13px] leading-[1.5] text-body">{benefit.body}</span>
            </div>
          </div>
        ))}
      </div>
      <p class="m-0 max-w-[480px] border-t border-line pt-4 text-[14px] leading-[1.6] text-muted">
        An outage a customer finds first costs more than a year of this.
      </p>
    </div>

    <div class="flex flex-col gap-[22px] rounded-2xl bg-ink p-8 max-lg:max-w-[480px]">
      <div class="flex items-center">
        <Logo iconSize={26} textSize={15} dark />
      </div>
      <div class="flex items-baseline gap-2">
        <span class="text-[46px] font-semibold leading-none tracking-[-0.03em] text-surface">39 €</span>
        <span class="text-sm text-parch">per month, per workspace</span>
      </div>
      <div class="h-px bg-white/8"></div>
      <div class="flex flex-col gap-[11px]">
        {included.map((t) => (
          <div class="flex items-start gap-[11px]">
            <Icon name="check" size={15} color="#FAF8F4" class="mt-[3px] opacity-75" />
            <span class="text-sm leading-normal text-parch">{t}</span>
          </div>
        ))}
      </div>
      <a
        href="https://app.zenguy.com"
        class="btn btn-violet rounded-[10px] py-[13px] text-center text-[15px] font-medium">Run your first test</a
      >
      <span class="text-center text-[12.5px] text-dusk">Billed monthly through Stripe. Cancel anytime — no lock-in.</span>
    </div>
  </div>
</section>
