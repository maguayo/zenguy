---
// Proposal 2 — Evidence upgraded, same structure as the live section: the
// screenshots strip moves inside the run card, the failed step carries the
// drama, and the Markdown report becomes a real artifact you can download
// without signing up.
import Icon from "./../Icon.astro";

const features = [
  {
    icon: "camera" as const,
    title: "Screenshots through the whole run",
    body: "See the page as the agent saw it from storefront to checkout, alongside the failed result.",
  },
  {
    icon: "circleslash" as const,
    title: "Expected against observed",
    body: "Stated plainly. The cart said 149,00 €, the checkout said 0,00 €.",
  },
  {
    icon: "network" as const,
    title: "Console and network around the failure",
    body: "The 500 that broke the page, with query strings sanitised and bodies never stored.",
  },
  {
    icon: "file" as const,
    title: "A Markdown report",
    body: "Facts only, no guessed root cause. Hand it to a developer or paste it into a coding agent.",
  },
];

const steps = [
  {
    n: 1,
    t: "00:02",
    action: "Opened acme-shop.com",
    note: "Landing page rendered, 200",
    failed: false,
    screenshot: "/hero/step-home.png",
    screenshotAlt: "Acme Shop home page captured at the start of the run",
  },
  {
    n: 2,
    t: "00:09",
    action: 'Clicked "Wireless headphones"',
    note: "Product page rendered",
    failed: false,
    screenshot: "/hero/step-product.png",
    screenshotAlt: "Wireless headphones product page captured after step two",
  },
  {
    n: 3,
    t: "00:14",
    action: 'Clicked "Add to cart"',
    note: "Cart drawer opened, 1 item",
    failed: false,
    screenshot: "/hero/step-cart.png",
    screenshotAlt: "Cart drawer with one item captured after step three",
  },
  {
    n: 4,
    t: "00:21",
    action: "Read cart total",
    note: "Cart shows 149,00 €",
    failed: false,
    screenshot: null,
    screenshotAlt: "",
  },
  {
    n: 5,
    t: "00:27",
    action: 'Clicked "Go to checkout"',
    note: "Navigated to checkout.acme-shop.com",
    failed: false,
    screenshot: "/hero/step-checkout.png",
    screenshotAlt: "Checkout page captured after step five",
  },
  {
    n: 6,
    t: "00:44",
    action: "Read order summary",
    note: "Order total shows 0,00 €",
    failed: false,
    screenshot: null,
    screenshotAlt: "",
  },
  {
    n: 7,
    t: "01:19",
    action: "Reloaded and re-read total",
    note: "Order total still 0,00 €",
    failed: true,
    screenshot: null,
    screenshotAlt: "",
  },
];

const thumbs = [
  { label: "step 1", src: "/hero/step-home.png", alt: "Store home page", bg: "#2A2722" },
  { label: "step 2", src: "/hero/step-product.png", alt: "Wireless headphones product page", bg: "#3D3933" },
  { label: "step 3", src: "/hero/step-cart.png", alt: "Cart with one item", bg: "#2A2722" },
  { label: "step 5", src: "/hero/step-checkout.png", alt: "Checkout page", bg: "#13110D" },
];

const reportHref = "/sample/checkout-production_8f2c1a_failure-report.md";
---

<section id="evidence" class="px-10 py-24 max-md:px-5 max-md:py-16">
  <div
    class="container-site grid grid-cols-[minmax(0,1fr)_minmax(0,1.12fr)] items-center gap-16 max-lg:grid-cols-1 max-lg:gap-12"
  >
    <div class="flex flex-col gap-5">
      <span class="eyebrow">Evidence</span>
      <h2 class="m-0 text-[40px] font-semibold leading-[1.14] tracking-[-0.025em] [text-wrap:balance] max-md:text-[32px]">
        When it fails, you get the whole story.
      </h2>
      <p class="m-0 text-[16px] leading-[1.62] text-body [text-wrap:pretty]">
        Not a red cross and a stack trace. Every attempt is recorded: what the agent clicked, what
        it saw at each step, what it expected instead, and the console and network activity around
        the failure.
      </p>
      <div class="flex flex-col gap-4 pt-1.5">
        {features.map((f) => (
          <div class="flex items-start gap-[13px]">
            <Icon name={f.icon} size={17} class="mt-0.5" />
            <div class="flex flex-col gap-[3px]">
              <span class="text-[14.5px] font-semibold">{f.title}</span>
              <span class="text-[13.5px] leading-[1.55] text-body">{f.body}</span>
            </div>
          </div>
        ))}
      </div>
      <a href={reportHref} download class="text-[14.5px] font-medium text-violet">
        Read the sample report →
      </a>
    </div>

    <div class="card-shadow overflow-hidden rounded-[14px] border border-line bg-surface">
      <div class="flex items-center gap-2.5 border-b border-line px-[18px] py-[13px]">
        <span class="text-[13.5px] font-semibold">Steps</span>
        <span class="text-xs text-muted">7 actions · 2 domains · 4 screenshots</span>
      </div>
      {steps.map((s) => (
        <div
          class:list={[
            "flex items-center gap-3 border-b border-cream px-[18px] py-[11px]",
            s.failed && "bg-red/5",
          ]}
        >
          <span class="flex h-[21px] w-[21px] shrink-0 items-center justify-center rounded-md bg-cream font-mono text-[11px] font-medium">
            {s.n}
          </span>
          <span class="w-[38px] shrink-0 font-mono text-[11.5px] text-muted">{s.t}</span>
          <span class="whitespace-nowrap text-[13px] font-medium max-md:whitespace-normal">{s.action}</span>
          <span class="truncate text-xs text-muted max-md:hidden">{s.note}</span>
          {s.failed ? (
            <span class="ml-auto inline-flex shrink-0 items-center gap-1.5 rounded-full bg-red/12 px-2 py-[3px] text-[11px] font-medium">
              <span class="zg-pulse h-1.5 w-1.5 rounded-full bg-red" aria-hidden="true"></span>check failed
            </span>
          ) : s.screenshot ? (
            <a
              href={s.screenshot}
              class="ml-auto inline-flex h-7 w-7 shrink-0 cursor-pointer items-center justify-center rounded-lg border border-line bg-surface text-ink transition-colors hover:bg-cream focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-violet"
              data-screenshot-trigger
              data-screenshot-src={s.screenshot}
              data-screenshot-alt={s.screenshotAlt}
              data-screenshot-title={`Step ${s.n} · ${s.t}`}
              data-screenshot-caption={`${s.action} — ${s.note}`}
              aria-label={`Open screenshot for step ${s.n}: ${s.action}`}
              aria-haspopup="dialog"
              aria-controls="screenshot-dialog"
              title="View screenshot"
            >
              <Icon name="camera" size={14} class="opacity-70" />
            </a>
          ) : (
            <span class="ml-auto h-7 w-7 shrink-0" aria-hidden="true"></span>
          )}
        </div>
      ))}
      <div class="flex gap-2 border-b border-cream px-[18px] py-3">
        {thumbs.map((t) => (
          <a
            href={t.src}
            class="relative aspect-[16/10] flex-1 overflow-hidden rounded-[7px] border border-sand"
            style={`background:${t.bg}`}
            data-screenshot-trigger
            data-screenshot-src={t.src}
            data-screenshot-alt={t.alt}
            data-screenshot-title={`${t.label.replace("step", "Step")} screenshot`}
            data-screenshot-caption={t.alt}
            aria-label={`Open ${t.label} screenshot`}
            aria-haspopup="dialog"
            aria-controls="screenshot-dialog"
          >
            <img src={t.src} alt={t.alt} width="600" height="375" loading="lazy" decoding="async" class="h-full w-full object-cover" />
            <span
              class:list={[
                "absolute bottom-1.5 left-1.5 rounded-[4px] px-[5px] py-[2px] font-mono text-[9px] leading-none",
                "bg-ink/85 text-dusk",
              ]}>{t.label}</span
            >
          </a>
        ))}
      </div>
      <div class="flex items-center gap-2.5 border-b border-cream px-[18px] py-3.5">
        <Icon name="file" size={15} />
        <span class="truncate font-mono text-xs text-body">checkout-production_8f2c1a_failure-report.md</span>
        <a href={reportHref} download class="ml-auto shrink-0 text-xs font-medium text-violet">Download</a>
      </div>
      <div class="flex items-center gap-[11px] bg-cream px-[18px] py-3.5">
        <Icon name="shield" size={15} />
        <span class="text-xs leading-normal text-body">Secret values are redacted in every screenshot, report and log.</span>
      </div>
    </div>
  </div>
</section>
