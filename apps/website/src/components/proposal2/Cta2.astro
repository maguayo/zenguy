---
// Proposal 2 — the closing CTA keeps its line and gains the three facts that
// remove the last hesitation, plus a low-commitment second path for the
// visitor who isn't ready to sign up.
import Price from "../Price.astro";
---

<section class="px-10 pb-24 max-md:px-5 max-md:pb-16">
  <div
    class="container-site card-shadow-sm flex items-center gap-12 rounded-2xl border border-line bg-surface px-14 py-16 max-lg:flex-col max-lg:items-start max-lg:gap-8 max-md:px-6 max-md:py-10"
  >
    <div class="flex max-w-[620px] flex-col gap-3.5">
      <h2 class="m-0 text-[36px] font-semibold leading-[1.14] tracking-[-0.025em] [text-wrap:balance] max-md:text-[28px]">
        Start with the flow you'd hate to find broken.
      </h2>
      <p class="m-0 text-[16px] leading-[1.6] text-body">
        Write it in a sentence, run it once, and see what comes back.
      </p>
      <div class="flex flex-wrap items-center gap-x-[22px] gap-y-1.5 pt-1 font-mono text-sm text-stone">
        <span><Price kind="monthly" /> a month</span>
        <span>first test in minutes</span>
        <span>cancel anytime</span>
      </div>
    </div>
    <div class="flex-1 max-lg:hidden"></div>
    <div class="flex shrink-0 flex-col items-center gap-3 max-lg:items-start">
      <a
        href="https://app.zenguy.com/signup"
        class="btn btn-violet rounded-[10px] px-6 py-3.5 text-[15px] font-medium"
        data-analytics-cta="closing_signup"
        data-analytics-destination="signup">Run your first test</a
      >
      <a
        href="/sample/checkout-production_8f2c1a_failure-report.md"
        download
        class="text-[13px] font-medium text-violet">or read a sample report</a
      >
    </div>
  </div>
</section>
