---
// Official lockup: icon (from icon-logo.svg) + lowercase wordmark + violet dot.
interface Props {
  iconSize?: number; // icon square in px (nav 19, footer 18, pricing 26)
  textSize?: number; // wordmark font-size in px (default scales with icon)
  dark?: boolean; // wordmark color on dark surfaces
  iconOnly?: boolean;
}

const { iconSize = 19, textSize, dark = false, iconOnly = false } = Astro.props;
const ts = textSize ?? Math.round(iconSize * 0.84);
---

<span class="inline-flex items-center gap-[8px]">
  <svg
    viewBox="0 0 32 32"
    xmlns="http://www.w3.org/2000/svg"
    width={iconSize}
    height={iconSize}
    class="shrink-0"
    aria-hidden="true"
  >
    <rect x="1" y="1" width="30" height="30" rx="9" fill="oklch(0.18 0.01 80)"></rect>
    <path
      d="M9 10.5 Q 12 9.5 16 10.5 T 23 10.5 L 9 21.5 Q 12 22.5 16 21.5 T 23 21.5"
      stroke="oklch(0.985 0.005 80)"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      fill="none"></path>
    <circle cx="23" cy="21.5" r="1.6" fill="oklch(0.55 0.18 280)"></circle>
  </svg>
  {!iconOnly && (
    <span
      class:list={["font-semibold tracking-[-0.01em] leading-none", dark ? "text-surface" : "text-ink"]}
      style={`font-size:${ts}px;`}
      >zenguy<span class="text-violet">.</span></span
    >
  )}
</span>
