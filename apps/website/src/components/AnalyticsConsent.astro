---
interface Props {
  pagePath: string;
}

const { pagePath } = Astro.props;
---

<section
  class="consent-banner"
  data-consent-banner
  data-analytics-page-path={pagePath}
  hidden
  role="dialog"
  aria-modal="false"
  aria-labelledby="consent-banner-title"
  aria-describedby="consent-banner-description"
>
  <div class="consent-copy">
    <h2 id="consent-banner-title">Optional analytics</h2>
    <p id="consent-banner-description">
      We use Google Analytics only if you choose to allow it. It helps us understand how the public
      website is used. We do not load the Google tag or send analytics data before you accept.
    </p>
  </div>
  <div class="consent-actions" aria-label="Analytics choices">
    <button class="consent-choice" type="button" data-consent-accept>Accept analytics</button>
    <button class="consent-choice" type="button" data-consent-reject>Reject analytics</button>
  </div>
  <a class="consent-preferences-link" href="/cookies/#cookie-preferences" data-cookie-preferences>
    Cookie preferences
  </a>
</section>

<dialog
  class="consent-dialog"
  data-consent-dialog
  aria-labelledby="consent-dialog-title"
  aria-describedby="consent-dialog-description"
>
  <form data-consent-form>
    <div class="consent-dialog-heading">
      <div>
        <span class="eyebrow">Privacy controls</span>
        <h2 id="consent-dialog-title">Cookie preferences</h2>
      </div>
      <button class="consent-dialog-close" type="button" data-consent-dialog-close aria-label="Close cookie preferences">
        <span aria-hidden="true">×</span>
      </button>
    </div>
    <p id="consent-dialog-description">
      Necessary storage remembers your choice. Analytics is optional and remains off unless you
      enable it here.
    </p>

    <div class="consent-setting">
      <div>
        <span class="consent-setting-title">Necessary storage</span>
        <span class="consent-setting-description">Stores this preference for up to 12 months.</span>
      </div>
      <span class="consent-always-on">Always on</span>
    </div>

    <label class="consent-setting" for="analytics-consent-choice">
      <span>
        <span class="consent-setting-title">Google Analytics</span>
        <span class="consent-setting-description">
          Measures aggregate visits and page use on this public website.
        </span>
      </span>
      <input id="analytics-consent-choice" type="checkbox" data-consent-analytics />
    </label>

    <p class="consent-policy-link">
      Read the <a href="/cookies/">Cookie Policy</a> and <a href="/privacy/">Privacy Policy</a> for details.
    </p>
    <div class="consent-dialog-actions">
      <button class="consent-save" type="submit">Save preferences</button>
      <button class="consent-cancel" type="button" data-consent-dialog-close>Cancel</button>
    </div>
  </form>
</dialog>

<p class="sr-only" aria-live="polite" data-consent-status></p>

<script src="../scripts/analytics-consent.ts"></script>

<style>
  .consent-banner {
    position: fixed;
    z-index: 50;
    right: 20px;
    bottom: 20px;
    left: 20px;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 18px 24px;
    width: min(760px, calc(100% - 40px));
    margin: 0 auto;
    padding: 22px;
    border: 1px solid var(--color-line);
    border-radius: 14px;
    background: var(--color-surface);
    color: var(--color-body);
    box-shadow:
      rgba(19, 17, 13, 0.1) 0 12px 32px,
      rgba(19, 17, 13, 0.08) 0 2px 6px;
  }

  .consent-banner[hidden] {
    display: none;
  }

  .consent-copy h2,
  .consent-dialog h2 {
    margin: 0;
    color: var(--color-ink);
    font-size: 20px;
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  .consent-copy p,
  .consent-dialog > form > p {
    margin: 7px 0 0;
    font-size: 14px;
    line-height: 1.55;
  }

  .consent-actions {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    align-self: center;
    gap: 10px;
  }

  .consent-choice {
    min-height: 44px;
    padding: 10px 14px;
    border: 1px solid var(--color-ink);
    border-radius: 8px;
    background: var(--color-ink);
    color: var(--color-surface);
    cursor: pointer;
    font: 500 13px var(--font-sans);
    white-space: nowrap;
  }

  .consent-choice:hover {
    background: var(--color-inkcard);
  }

  .consent-choice:focus-visible,
  .consent-save:focus-visible,
  .consent-cancel:focus-visible,
  .consent-dialog-close:focus-visible {
    outline: 2px solid var(--color-violet);
    outline-offset: 2px;
  }

  .consent-preferences-link {
    grid-column: 1 / -1;
    width: fit-content;
    font-size: 13px;
  }

  .consent-dialog {
    width: min(560px, calc(100% - 32px));
    max-height: calc(100dvh - 32px);
    padding: 0;
    overflow: auto;
    border: 1px solid var(--color-line);
    border-radius: 14px;
    background: var(--color-surface);
    color: var(--color-body);
    box-shadow: rgba(19, 17, 13, 0.24) 0 24px 64px;
  }

  .consent-dialog::backdrop {
    background: rgba(19, 17, 13, 0.48);
  }

  .consent-dialog form {
    padding: 26px;
  }

  .consent-dialog-heading {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 20px;
  }

  .consent-dialog-heading h2 {
    margin-top: 6px;
    font-size: 25px;
  }

  .consent-dialog-close {
    display: inline-grid;
    width: 36px;
    height: 36px;
    flex: 0 0 auto;
    place-items: center;
    padding: 0;
    border: 1px solid var(--color-line);
    border-radius: 8px;
    background: transparent;
    color: var(--color-body);
    cursor: pointer;
    font-size: 24px;
    line-height: 1;
  }

  .consent-setting {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    margin-top: 18px;
    padding: 16px;
    border: 1px solid var(--color-line);
    border-radius: 10px;
    background: var(--color-cream);
  }

  .consent-setting-title,
  .consent-setting-description {
    display: block;
  }

  .consent-setting-title {
    color: var(--color-ink);
    font-size: 14px;
    font-weight: 600;
  }

  .consent-setting-description {
    margin-top: 3px;
    font-size: 13px;
    line-height: 1.45;
  }

  .consent-always-on {
    flex: 0 0 auto;
    color: var(--color-muted);
    font: 500 11px var(--font-mono);
    text-transform: uppercase;
  }

  .consent-setting input {
    width: 22px;
    height: 22px;
    flex: 0 0 auto;
    accent-color: var(--color-violet);
  }

  .consent-policy-link {
    font-size: 13px !important;
  }

  .consent-dialog-actions {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-top: 24px;
  }

  .consent-save,
  .consent-cancel {
    min-height: 42px;
    padding: 9px 15px;
    border-radius: 8px;
    cursor: pointer;
    font: 500 13px var(--font-sans);
  }

  .consent-save {
    border: 1px solid var(--color-ink);
    background: var(--color-ink);
    color: var(--color-surface);
  }

  .consent-cancel {
    border: 1px solid var(--color-line);
    background: transparent;
    color: var(--color-ink);
  }

  @media (max-width: 720px) {
    .consent-banner {
      right: 12px;
      bottom: 12px;
      left: 12px;
      grid-template-columns: 1fr;
      width: auto;
      padding: 18px;
    }

    .consent-actions {
      width: 100%;
    }

    .consent-preferences-link {
      grid-column: auto;
    }
  }

  @media (max-width: 440px) {
    .consent-actions,
    .consent-dialog-actions {
      display: grid;
      grid-template-columns: 1fr;
    }

    .consent-choice,
    .consent-save,
    .consent-cancel {
      width: 100%;
    }

    .consent-setting {
      align-items: flex-start;
      gap: 14px;
    }
  }
</style>
