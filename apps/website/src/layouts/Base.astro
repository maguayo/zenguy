---
import "../styles/global.css";
import AnalyticsConsent from "../components/AnalyticsConsent.astro";

interface Props {
  title?: string;
  description?: string;
  ogType?: "website" | "article";
  publishedTime?: Date;
  image?: string;
  analyticsPath?: string;
}

const {
  title = "Zenguy — Browser tests in plain English",
  description = "Describe a flow once. Zenguy walks it on a schedule and, when it stops working, sends you the screenshots, the steps and the reason before a customer finds it.",
  ogType = "website",
  publishedTime,
  image,
  analyticsPath = Astro.url.pathname,
} = Astro.props;

const site = Astro.site ?? "https://zenguy.com";
const canonical = new URL(Astro.url.pathname, site).href;
const publishedIso = publishedTime?.toISOString();
const ogImage = image ? new URL(image, site).href : undefined;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/x-icon" sizes="16x16 32x32 48x48" href="/favicon.ico" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48x48.png" />
    <link rel="icon" type="image/svg+xml" sizes="any" href="/favicon.svg" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="mask-icon" href="/safari-pinned-tab.svg" color="#615ED6" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="apple-mobile-web-app-title" content="Zenguy" />
    <link rel="alternate" type="application/rss+xml" title="Zenguy articles" href="/articles/rss.xml" />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Zenguy" />
    {ogImage && <meta property="og:image" content={ogImage} />}
    {publishedIso && <meta property="article:published_time" content={publishedIso} />}
    <meta name="twitter:card" content={ogImage ? "summary_large_image" : "summary"} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {ogImage && <meta name="twitter:image" content={ogImage} />}
    <meta name="theme-color" content="#F2EEE6" />
    <slot name="head" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Geist:wght@400..700&family=Geist+Mono:wght@400..500&family=Caveat:wght@600..700&display=swap"
    />
  </head>
  <body>
    <slot />
    <AnalyticsConsent pagePath={analyticsPath} />
    <script src="../scripts/pricing.mjs"></script>
  </body>
</html>
