{
  // Cloudflare Pages config for the marketing site (git-connected project "zenguy").
  // The Pages build reads `pages_build_output_dir` from here (name must match the
  // Pages project). Dashboard settings: Root directory = "apps/website",
  // Build command = "pnpm build".
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "zenguy",
  "compatibility_date": "2026-08-01",
  "pages_build_output_dir": "./dist"
}
