{
  "name": "zenguy",
  "private": true,
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": "22.23.2"
  },
  "scripts": {
    "dev:api": "pnpm --filter @zenguy/api dev",
    "dev:frontend": "pnpm --filter @zenguy/frontend dev",
    "build": "pnpm -r build",
    "security:audit:cloudflare": "node scripts/security/audit-cloudflare-edge.mjs",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "app:install": "pnpm --dir apps/app install",
    "app:start": "pnpm --dir apps/app start",
    "app:ios": "pnpm --dir apps/app ios",
    "app:test": "pnpm --dir apps/app test",
    "app:typecheck": "pnpm --dir apps/app typecheck"
  }
}
